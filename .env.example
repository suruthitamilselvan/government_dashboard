# ─── Citizen Service Assistant — Environment Variables ───────────────────────
# Copy this file to .env and fill in your values.
# Never commit the real .env file to version control.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_DEBUG=0
FLASK_SECRET=change-this-flask-secret-key
PORT=5000

# ── AI / LLM (Optional — falls back to RAG snippet if not set) ───────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Get from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Email Notifications (SMTP) ────────────────────────────────────────────────
# Gmail users: use an App Password (not your main password)
# App Passwords: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# Support notification recipients (up to 3)
SUPPORT_EMAIL_1=admin@yourdepartment.gov.in
SUPPORT_EMAIL_2=support@yourdepartment.gov.in
# SUPPORT_EMAIL_3=helpdesk@yourdepartment.gov.in

# ── Agent Dashboard ───────────────────────────────────────────────────────────
# Shared password for all agents. Change before production.
AGENT_SECRET_KEY=changeme-agent-secret-2026

# ── SSL Bypass (Windows corporate networks) ───────────────────────────────────
# These are already set in app.py via os.environ.setdefault().
# Only override here if needed.
# HF_HUB_DISABLE_SSL_VERIFY=1
